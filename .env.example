# Copie para .env e gere segredos independentes. Nunca versione o arquivo preenchido.
APP_ENV=development
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://walleturbo:alterar@db:5432/walleturbo
POSTGRES_PASSWORD=alterar
REDIS_URL=redis://redis:6379/0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# O provedor deve emitir acr=2 apenas depois de dois fatores verificados.
REQUIRED_ACR=2
