{
  "realm": "walleturbo",
  "enabled": true,
  "displayName": "Walleturbo — desenvolvimento",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "passwordPolicy": "length(14) and digits(1) and upperCase(1) and lowerCase(1)",
  "browserFlow": "walleturbo-browser",
  "authenticationFlows": [
    {
      "alias": "walleturbo-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "walleturbo-password"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "walleturbo-mfa"
        }
      ]
    },
    {
      "alias": "walleturbo-password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "walleturbo-loa-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "walleturbo-mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "walleturbo-loa-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "walleturbo-broker-mfa",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false,
          "flowAlias": "walleturbo-mfa"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "walleturbo-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "walleturbo-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    }
  ],
  "clients": [
    {
      "clientId": "walleturbo-web",
      "name": "Walleturbo Web local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WALLETURBO_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "acr.loa.map": "{\"1\":1,\"2\":2}",
        "default.acr.values": "2",
        "minimum.acr.value": "2"
      },
      "defaultClientScopes": [
        "profile",
        "acr"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "acr",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
